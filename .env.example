# Copy to .env and fill in. Never commit .env.

# Which drafting engine to use: anthropic | openai | offline
#   anthropic - Claude via the Anthropic API (deck text is sent to Anthropic)
#   openai    - any OpenAI-compatible chat endpoint (deck text is sent to that endpoint)
#   offline   - no model; verbatim, page-referenced extraction; nothing leaves this machine
TEASER_LLM_PROVIDER=anthropic

# Model name. Defaults to claude-opus-5-5 for anthropic; required for openai.
TEASER_LLM_MODEL=

# Anthropic credentials (provider=anthropic)
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=

# OpenAI-compatible credentials (provider=openai). Set OPENAI_BASE_URL for Azure, vLLM, Ollama, etc.
OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Reasoning effort for Anthropic models that support it: low | medium | high | xhigh | max | none
TEASER_LLM_EFFORT=high

# Request timeout in seconds
TEASER_LLM_TIMEOUT=300

# OCR for scanned PDFs / image-only slides (requires rapidocr-onnxruntime)
TEASER_ENABLE_OCR=true

# Add the TEN Capital standard footer to exports (can also be toggled in the app)
TEASER_TEN_FOOTER=true

# Result emails via Resend (off unless RESEND_API_KEY is set). Each generated draft and each
# approved download is emailed. The sender must be on a domain verified in Resend.
RESEND_API_KEY=
REPORT_EMAIL_TO=Info@tencapital.group
REPORT_EMAIL_FROM=TEN Capital Investor Teaser <teaser@tencapital.group>
# Also email runs of the bundled synthetic sample deck (off so demos don't fill the inbox)
EMAIL_DEMO_RUNS=false
